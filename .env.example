# Telegram
BOT_TOKEN=
ADMIN_ID=

# PostgreSQL (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://economy_bot:change_me@postgres:5432/economy_bot
POSTGRES_PASSWORD=change_me

# LLM. The bot never treats its output as a source of theory.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

# Website answer submission; keep private and use HTTPS if exposed beyond localhost.
WEB_PASSWORD=

# Runtime
LOG_LEVEL=INFO
REMINDER_HOUR=20
TIMEZONE=Asia/Yekaterinburg
UPLOAD_DIR=uploads
