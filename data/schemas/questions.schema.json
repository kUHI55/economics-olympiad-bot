{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "questions.schema.json",
  "title": "Economics theory question document",
  "type": "object",
  "required": ["schema_version", "section", "topic", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "section": {"$ref": "#/$defs/id"},
    "section_title": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
    "topic": {"$ref": "#/$defs/id"},
    "topic_title": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
    "subtopic": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "subtopic_title": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
    "is_demo": {"type": "boolean", "default": false},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "source": {
      "type": "object",
      "required": ["id", "name", "source_type", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 2},
        "source_type": {"enum": ["text", "txt", "pdf", "docx", "markdown"]},
        "source_date": {"type": ["string", "null"], "format": "date"},
        "excerpt": {"type": "string", "minLength": 5}
      }
    },
    "option": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "text": {"type": "string", "minLength": 1}}
    },
    "question": {
      "type": "object",
      "required": ["id", "knowledge_id", "type", "difficulty", "question", "reference_answer", "key_points", "explanation", "source", "source_excerpt"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "knowledge_id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["formula", "definition", "notation", "understanding", "causal_relationship", "comparison", "common_mistake", "multiple_choice"]},
        "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
        "question": {"type": "string", "minLength": 5},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "correct_answer": {"type": ["string", "null"]},
        "reference_answer": {"type": "string", "minLength": 1},
        "key_points": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "explanation": {"type": "string", "minLength": 2},
        "source": {"$ref": "#/$defs/source"},
        "source_excerpt": {"type": "string", "minLength": 5}
      }
    }
  }
}
