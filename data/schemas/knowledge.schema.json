{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge.schema.json",
  "title": "Economics theory knowledge document",
  "type": "object",
  "required": ["schema_version", "section", "topic", "knowledge"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "section": {"$ref": "#/$defs/id"},
    "topic": {"$ref": "#/$defs/id"},
    "subtopic": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "is_demo": {"type": "boolean", "default": false},
    "knowledge": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/knowledge"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "source": {
      "type": "object",
      "required": ["id", "name", "source_type", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 2},
        "source_type": {"enum": ["text", "txt", "pdf", "docx", "markdown"]},
        "source_date": {"type": ["string", "null"], "format": "date"},
        "excerpt": {"type": "string", "minLength": 5}
      }
    },
    "knowledge": {
      "type": "object",
      "required": ["id", "title", "type", "explanation", "source"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 2},
        "type": {"enum": ["definition", "formula", "notation", "mechanism", "causal_relationship", "comparison", "example", "graphical_concept", "common_mistake", "term"]},
        "formula": {"type": ["string", "null"]},
        "definitions": {"type": "object", "additionalProperties": {"type": "string"}},
        "explanation": {"type": "string", "minLength": 2},
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
